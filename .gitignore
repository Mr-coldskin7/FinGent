# ── 环境 / 密钥 ───────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Python ────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.pyo

# ── 编辑器 ────────────────────────────────────────────────────────
.vscode/
.idea/

# ── 开发代理会话数据 ──────────────────────────────────────────────
.pi/
# 评测产物（每次运行生成，不入库）
Eval/runs/
logs/
.cache/

# 记忆库备份（迁移/清理前自动备份，不入库）
memory/backups/
# 运行时用户数据库（含用户分析历史，不入库）
memory/*.db
*.bak

# Playwright 浏览器会话产物（截图/console 日志，不入库）
.playwright-mcp/
