# FinGent 环境变量示例
# 复制本文件为 .env 并填入实际值

# ── LLM 配置（必填） ─────────────────────────────────────────────
QIANWEN_API_KEY=your-dashscope-api-key-here
MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODEL_NAME=qwen-max
MODEL_TEMPERATURE=0.5

# ── 数据源 API Keys（按需填写） ──────────────────────────────────
FMP_API_KEY=
TIINGO_API_KEY=
BOCHA_API_KEY=
TUSHARE_TOKEN=

# ── 存储配置 ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
MYSQL_URL=mysql+pymysql://root:password@localhost:3306/fingent
FINGENT_MEMORY_DB=./memory/l3_memory.db

# ── 缓存配置 ─────────────────────────────────────────────────────
CACHE_DEFAULT_TTL=300
CACHE_REDIS_TTL=600

# ── 投票阈值 ─────────────────────────────────────────────────────
VOTE_STRONG_THRESHOLD=0.75
VOTE_MAJORITY_THRESHOLD=0.4
VOTE_REDUCE_THRESHOLD=0.4

# ── 服务器配置 ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=*

# ── 回测配置 ─────────────────────────────────────────────────────
BACKTEST_MAX_CONCURRENT=5
BACKTEST_TIMEOUT=7200

# ── 调试/模拟日期（回测使用） ────────────────────────────────────
# FINGENT_SIMULATED_DATE=2024-12-31
